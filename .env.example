# Environment Variables for AGI-model
#
# Copy this file to `.env` for local development. Real secrets must NEVER
# be committed. See SECRETS.md for the full list of GitHub / Hugging Face
# secrets, and which variables are DEPRECATED.
#
# Most compose-time defaults are picked up by docker-compose.yml directly
# from the host environment. The values below are illustrative only.

# ---------- System ----------
TMT_OS_ENV=development
TMT_OS_HOST=localhost
TMT_OS_PORT=8000
LOG_LEVEL=INFO

# ---------- Security ----------
# Change these for any non-local use.
JWT_SECRET=change_me_in_production
ENCRYPTION_KEY=change_me_in_production

# ---------- Database (compose) ----------
# The local compose stack reads POSTGRES_PASSWORD from the host env.
# The string below is for a dev box only.
DATABASE_URL=postgresql://tmtos:change_me@localhost:5432/tmt_os_dev
DATABASE_POOL_SIZE=10

# ---------- Redis (compose) ----------
REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=  # leave empty in dev; see config/redis.conf

# ---------- IBM Quantum (optional) ----------
# Required only for `analyze_ibm_*.py` and any hardware-submitting demo.
# QISKIT_IBM_TOKEN=
# IBM_BACKEND=ibmq_qasm_simulator

# ---------- Monitoring (compose) ----------
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true

# ---------- Performance ----------
MAX_WORKERS=4
BATCH_SIZE=32

# ---------- DEPRECATED (do not uncomment) ----------
# The variables below were used by the NFT / IPFS publishing pipeline.
# That pipeline is disabled (see SECRETS.md -> DEPRECATED). They are kept
# here only as a historical reference and are NOT consumed by any code path.
#
# PINATA_JWT=
# PINATA_API_KEY=
# PINATA_API_SECRET=
# NFT_ENABLED=false
# NFT_CONTRACT_ADDRESS=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SLACK_WEBHOOK_URL=