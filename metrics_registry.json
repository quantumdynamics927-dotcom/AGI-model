{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metric Registry for Quantum-Consciousness AGI Project",
  "description": "Formal specification of all metrics with equations, constraints, null models, and validation criteria",
  "version": "1.0.0",
  "last_updated": "2026-04-15",
  
  "metrics": {
    "phi_invariant_score": {
      "name": "φ-Invariant Score",
      "symbol": "S_inv",
      "classification": "PRIMARY",
      "equation": {
        "latex": "S_{inv} = \\frac{N_{surviving}}{N_{total}}",
        "python": "S_inv = surviving_patterns / total_patterns"
      },
      "input_data": {
        "type": "quantum_circuit",
        "description": "Sierpinski triangle quantum circuit execution results",
        "required_fields": ["surviving_patterns", "total_patterns"]
      },
      "output_range": {
        "min": 0.0,
        "max": 1.0,
        "expected": 0.618033988749895,
        "tolerance": 0.05
      },
      "units": "dimensionless",
      "invariances": ["depth_invariant", "backend_invariant"],
      "constraints": {
        "numerical": ["0 <= S_inv <= 1"],
        "physical": ["S_inv ≈ 1/φ for Sierpinski circuits"]
      },
      "null_model": {
        "description": "Random quantum circuit",
        "expected_value": 0.5,
        "expected_variance": 0.0025
      },
      "benchmark_target": {
        "sierpinski_depth_3": 0.618,
        "sierpinski_depth_4": 0.618,
        "sierpinski_depth_5": 0.618
      },
      "failure_condition": "|S_inv - 0.618| > 0.05 across multiple backends",
      "evidence_sources": [
        "hardware_evidence_ledger_v2.json",
        "backend_calibration_analysis.json",
        "sierpinski_metatron_analysis_results.json"
      ],
      "claims_supported": ["C1", "C5"],
      "validation_status": "PASSED"
    },
    
    "phi_ratio_proximity": {
      "name": "φ-Ratio Proximity",
      "symbol": "δ_φ",
      "classification": "PRIMARY",
      "equation": {
        "latex": "\\delta_\\phi = \\min_{r_i \\in R} |r_i - \\phi|",
        "python": "phi_proximity = np.min(np.abs(ratios - PHI))"
      },
      "input_data": {
        "type": "geometric_ratios",
        "description": "Ratios of consecutive sorted distances in geometric structure",
        "required_fields": ["positions"]
      },
      "output_range": {
        "min": 0.0,
        "max": null,
        "expected_for_icosahedron": 5.96e-5,
        "tolerance": 1e-4
      },
      "units": "dimensionless",
      "invariances": ["scale_invariant", "rotation_invariant"],
      "constraints": {
        "numerical": ["δ_φ >= 0"],
        "geometric": ["δ_φ < 1e-4 for icosahedron/dodecahedron"]
      },
      "null_model": {
        "description": "Random point cloud",
        "expected_value": 0.5,
        "expected_variance": 0.1
      },
      "benchmark_target": {
        "icosahedron": "< 1e-4",
        "dodecahedron": "< 1e-4",
        "tetrahedron": "> 0.1",
        "cube": "> 0.1"
      },
      "failure_condition": "Any other constant has smaller proximity than φ for icosahedron",
      "evidence_sources": [
        "validate_metrics.py",
        "metatron_geometry_demo.py"
      ],
      "claims_supported": ["C2"],
      "validation_status": "PASSED"
    },
    
    "entanglement_entropy": {
      "name": "Von Neumann Entanglement Entropy",
      "symbol": "S",
      "classification": "SECONDARY",
      "equation": {
        "latex": "S = -\\sum_i \\lambda_i \\log \\lambda_i",
        "python": "entropy = -np.sum(eigenvalues * np.log(eigenvalues + 1e-10))"
      },
      "input_data": {
        "type": "quantum_state",
        "description": "Quantum amplitudes from molecular encoding",
        "required_fields": ["amplitudes"]
      },
      "output_range": {
        "min": 0.0,
        "max": "log(d_A)",
        "expected_for_product_state": 0.0,
        "expected_for_maximally_entangled": "log(d_A)"
      },
      "units": "nats (natural log)",
      "invariances": ["unitary_invariant_on_subsystem_A"],
      "constraints": {
        "numerical": ["S >= 0", "S <= log(d_A)"],
        "quantum": ["Tr(ρ_A) = 1", "eigenvalues >= 0", "eigenvalues <= 1"]
      },
      "null_model": {
        "description": "Random state vector",
        "expected_value": "log(d_A) - O(1/d_A)",
        "expected_variance": "O(1/d_A)"
      },
      "benchmark_target": {
        "product_state": 0.0,
        "bell_state": "log(2) ≈ 0.693",
        "maximally_entangled": "log(d_A)"
      },
      "failure_condition": "S < 0 or S > log(d_A)",
      "evidence_sources": [
        "quantum_metatron_integration.py",
        "validate_metrics.py"
      ],
      "claims_supported": ["C3"],
      "validation_status": "WEAKENED",
      "notes": "Does not predict molecular complexity as hypothesized. Needs revision."
    },
    
    "quantum_coherence": {
      "name": "Quantum Coherence",
      "symbol": "C",
      "classification": "INTERPRETIVE",
      "equation": {
        "latex": "C = \\frac{\\sum_{i \\neq j} |\\rho_{ij}|}{n(n-1)}",
        "python": "coherence = off_diagonal_sum / (n * (n - 1))"
      },
      "input_data": {
        "type": "quantum_state",
        "description": "Amplitudes and phases of quantum state",
        "required_fields": ["amplitudes", "phases"]
      },
      "output_range": {
        "min": 0.0,
        "max": 1.0
      },
      "units": "dimensionless",
      "invariances": ["basis_dependent"],
      "constraints": {
        "numerical": ["0 <= C <= 1"],
        "quantum": ["C = 0 for diagonal density matrix", "C > 0 for coherent superposition"]
      },
      "null_model": {
        "description": "Random phases",
        "expected_value": "2/(π*n)",
        "expected_variance": "O(1/n²)"
      },
      "benchmark_target": {
        "pure_coherent_state": "~1/n",
        "maximally_mixed": 0.0
      },
      "failure_condition": "C < 0 or C > 1",
      "evidence_sources": [
        "quantum_metatron_integration.py",
        "validate_metrics.py"
      ],
      "claims_supported": [],
      "validation_status": "PASSED"
    },
    
    "platonic_alignment_score": {
      "name": "Platonic Solid Alignment Score",
      "symbol": "P_s",
      "classification": "PRIMARY",
      "equation": {
        "latex": "P_s = \\exp\\left(-\\frac{1}{N}\\sum_{i=1}^{N} \\min_j ||\\mathbf{r}_i - \\mathbf{t}_j^{(s)}||\\right)",
        "python": "P_s = np.exp(-np.mean(min_distances))"
      },
      "input_data": {
        "type": "molecular_positions",
        "description": "3D atomic coordinates",
        "required_fields": ["positions", "solid_name"]
      },
      "output_range": {
        "min": 0.0,
        "max": 1.0
      },
      "units": "dimensionless",
      "invariances": ["rotation_dependent", "scale_dependent"],
      "constraints": {
        "numerical": ["0 <= P_s <= 1"],
        "geometric": ["P_s = 1 for perfect match"]
      },
      "null_model": {
        "description": "Random point cloud in unit sphere",
        "expected_value": 0.6,
        "expected_variance": 0.1
      },
      "benchmark_target": {
        "tetrahedral_molecule": "P_tetrahedron > 0.6",
        "octahedral_molecule": "P_octahedron > 0.6",
        "random_points": "P < 0.5"
      },
      "failure_condition": "P_s > 1 or P_s < 0",
      "evidence_sources": [
        "metatron_geometry_demo.py",
        "validate_metrics.py"
      ],
      "claims_supported": ["C4"],
      "validation_status": "PASSED"
    },
    
    "tesseract_symmetry": {
      "name": "4D Tesseract Symmetry",
      "symbol": "T_4",
      "classification": "INTERPRETIVE",
      "equation": {
        "latex": "T_4 = 1 - \\frac{\\sigma_R}{\\bar{R}}",
        "python": "T_4 = 1 - (np.std(hyperradii) / np.mean(hyperradii))"
      },
      "input_data": {
        "type": "4d_positions",
        "description": "4D embedded coordinates",
        "required_fields": ["positions_4d"]
      },
      "output_range": {
        "min": "-infinity",
        "max": 1.0,
        "typical_range": [0.0, 1.0]
      },
      "units": "dimensionless",
      "invariances": ["4d_rotation_invariant"],
      "constraints": {
        "numerical": ["T_4 <= 1"],
        "geometric": ["T_4 = 1 for regular hypercube"]
      },
      "null_model": {
        "description": "Random 4D points",
        "expected_value": 0.3,
        "expected_variance": 0.2
      },
      "benchmark_target": {
        "regular_tesseract": 1.0,
        "random_4d": 0.3
      },
      "failure_condition": "T_4 > 1",
      "evidence_sources": [
        "metatron_geometry_demo.py",
        "quantum_metatron_integration.py"
      ],
      "claims_supported": [],
      "validation_status": "PASSED"
    },
    
    "phi_resonance": {
      "name": "φ-Resonance Score",
      "symbol": "R_φ",
      "classification": "PRIMARY",
      "equation": {
        "latex": "R_\\phi = \\exp(-\\alpha \\min_i |r_i - \\phi|)",
        "python": "R_phi = np.exp(-alpha * np.min(np.abs(ratios - PHI)))"
      },
      "input_data": {
        "type": "geometric_ratios",
        "description": "Ratios of distances in molecular geometry",
        "required_fields": ["positions"],
        "parameters": {
          "alpha": {
            "default": 1.0,
            "description": "Sensitivity parameter",
            "must_be_fixed_before_testing": true
          }
        }
      },
      "output_range": {
        "min": 0.0,
        "max": 1.0
      },
      "units": "dimensionless",
      "invariances": ["scale_invariant"],
      "constraints": {
        "numerical": ["0 <= R_φ <= 1"],
        "geometric": ["R_φ = 1 when some ratio exactly equals φ"]
      },
      "null_model": {
        "description": "Random molecular geometry",
        "expected_value": 0.6,
        "expected_variance": 0.1
      },
      "benchmark_target": {
        "icosahedron": "> 0.9",
        "dodecahedron": "> 0.9",
        "random_molecule": "0.5-0.7"
      },
      "failure_condition": "R_φ > 1 or R_φ < 0",
      "evidence_sources": [
        "metatron_geometry_demo.py",
        "validate_metrics.py"
      ],
      "claims_supported": ["C2"],
      "validation_status": "PASSED"
    },
    
    "quantum_bond_strength": {
      "name": "Quantum Bond Strength",
      "symbol": "B_ij",
      "classification": "SECONDARY",
      "equation": {
        "latex": "B_{ij} = \\frac{|\\langle\\psi_i|\\psi_j\\rangle|}{d_{ij} + 0.5}",
        "python": "B_ij = quantum_overlap / (distance + 0.5)"
      },
      "input_data": {
        "type": "atomic_pair",
        "description": "Positions and quantum states of atom pair",
        "required_fields": ["positions", "amplitudes", "phases"],
        "constraints": ["d_ij < 3.0 Angstrom (bonding threshold)"]
      },
      "output_range": {
        "min": 0.0,
        "max": null,
        "typical_range": [0.0, 2.0]
      },
      "units": "inverse angstrom",
      "invariances": ["translation_invariant", "rotation_invariant"],
      "constraints": {
        "numerical": ["B_ij >= 0"],
        "physical": ["Only computed for d_ij < 3.0 Angstrom"]
      },
      "null_model": {
        "description": "Random atomic positions with random quantum states",
        "expected_value": 0.25,
        "expected_variance": 0.1
      },
      "benchmark_target": {
        "single_bond": "~1.0",
        "double_bond": "~2.0",
        "no_bond": 0.0
      },
      "failure_condition": "B_ij < 0",
      "evidence_sources": [
        "quantum_metatron_integration.py"
      ],
      "claims_supported": [],
      "validation_status": "PASSED"
    },
    
